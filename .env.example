# Copy this file to .env and fill in your key(s). The .env file is gitignored.
# Real shell environment variables take precedence over values set here.

# Use OpenAI (default model is gpt-4o-mini, configurable in src/config.py):
OPENAI_API_KEY=sk-...

# Or use Anthropic Claude instead:
# ANTHROPIC_API_KEY=sk-ant-...

# Force a provider when both keys are set ("openai" | "anthropic"):
# LLM_PROVIDER=openai
